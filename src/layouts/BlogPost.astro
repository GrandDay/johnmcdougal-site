---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getSeriesGroups } from '../lib/series';

type Props = CollectionEntry<'blog'>['data'] & { id: string };

const { title, description, pubDate, updatedDate, heroImage, tags, series, seriesPart, projectRef, id } = Astro.props;
const socialImage = heroImage || undefined;

const allPosts = await getCollection('blog');
const allProjects = await getCollection('projects');

const seriesGroups = getSeriesGroups(allPosts);
const seriesGroup = series
  ? seriesGroups.find((group) => group.key === series)
  : undefined;
const currentSeriesIndex = seriesGroup
  ? seriesGroup.members.findIndex((post) => post.id === id)
  : -1;
if (seriesGroup && currentSeriesIndex < 0) {
  throw new Error(`Series "${seriesGroup.key}" does not contain current entry "${id}".`);
}
const seriesPrev = currentSeriesIndex > 0
  ? seriesGroup?.members[currentSeriesIndex - 1]
  : undefined;
const seriesNext = seriesGroup && currentSeriesIndex < seriesGroup.members.length - 1
  ? seriesGroup.members[currentSeriesIndex + 1]
  : undefined;

const relatedProject = projectRef
  ? allProjects.find((project) => project.id === projectRef)
  : undefined;
if (projectRef && !relatedProject) {
  throw new Error(`Blog entry "${id}" references missing public project "${projectRef}".`);
}

const related = allPosts
.filter((p) => p.id !== id && p.data.tags.some((t) => tags.includes(t)))
.sort((a, b) => {
const aShared = a.data.tags.filter((t) => tags.includes(t)).length;
const bShared = b.data.tags.filter((t) => tags.includes(t)).length;
if (bShared !== aShared) return bShared - aShared;
return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
})
.slice(0, 3);
---

<html lang="en">
<head>
<BaseHead title={title} description={description} image={socialImage} pubDate={pubDate} />
<style>
main {
width: calc(100% - 2em);
max-width: 100%;
margin: 0;
}
.hero-image { width: 100%; }
.hero-image img {
display: block;
margin: 0 auto;
border-radius: 12px;
box-shadow: var(--shadow);
}
.prose {
width: 720px;
max-width: calc(100% - 2em);
margin: auto;
padding: 1em 1em 3em;
color: var(--text);
}
.title {
margin-bottom: 1.5em;
padding: 1em 0;
border-bottom: 1px solid rgba(128,128,128,0.15);
}
.title h1 { margin: 0 0 0.35em; line-height: 1.2; }
.date { color: var(--text-muted); font-size: 0.875rem; margin-bottom: 0.25em; }
.last-updated-on { font-style: italic; }

/* Prose content */
.prose :global(p) { line-height: 1.75; margin: 0 0 1.1em; }
.prose :global(a) { color: var(--accent); }
.prose :global(a:hover) { text-decoration: underline; }
.prose :global(h2) {
font-size: 1.35rem;
margin: 2em 0 0.75em;
padding-bottom: 0.35em;
border-bottom: 1px solid rgba(128,128,128,0.12);
}
.prose :global(h3) { font-size: 1.1rem; margin: 1.5em 0 0.5em; }
.prose :global(ul), .prose :global(ol) {
padding-left: 1.5em;
margin: 0 0 1.1em;
line-height: 1.75;
}
.prose :global(li) { margin-bottom: 0.3em; }
.prose :global(code) {
font-size: 0.875em;
background: var(--bg-secondary);
padding: 0.15em 0.4em;
border-radius: 4px;
}
.prose :global(pre) {
background: var(--bg-secondary);
padding: 1.25em;
border-radius: 8px;
overflow-x: auto;
margin: 0 0 1.5em;
}
.prose :global(pre code) { background: none; padding: 0; font-size: 0.875em; }
.prose :global(blockquote) {
border-left: 3px solid var(--accent);
padding: 0.25em 0 0.25em 1em;
margin: 1.5em 0;
color: var(--text-muted);
font-style: italic;
}
.prose :global(hr) {
border: none;
border-top: 1px solid rgba(128,128,128,0.15);
margin: 2em 0;
}

/* Series label */
.series-label {
font-size: 0.75rem;
font-weight: 700;
letter-spacing: 0.08em;
text-transform: uppercase;
color: var(--accent);
margin: 0 0 0.4em;
}

/* Series navigation */
.series-context {
margin-top: 2.75em;
padding-top: 1.5em;
border-top: 1px solid rgba(128,128,128,0.15);
}
.series-context-heading {
margin-bottom: 1.25em;
}
.series-context-heading h2 {
font-size: 1.15rem;
margin: 0 0 0.35em;
padding: 0;
border: 0;
}
.series-context-heading p {
font-size: 0.9rem;
line-height: 1.55;
color: var(--text-muted);
margin: 0;
}
.series-nav {
display: grid;
grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
gap: 1em;
margin-bottom: 1.5em;
}
.series-nav-item {
display: flex;
flex-direction: column;
gap: 0.2em;
min-width: 0;
}
.series-nav-item.next { align-items: flex-end; text-align: right; }
.series-nav-dir {
font-size: 0.7rem;
font-weight: 700;
letter-spacing: 0.1em;
text-transform: uppercase;
color: var(--text-muted);
}
.series-nav-link {
font-size: 0.9rem;
display: flex;
align-items: center;
min-height: 44px;
color: var(--text);
text-decoration: none;
transition: color 0.15s;
}
.series-nav-link:hover { color: var(--accent); }
.series-nav-link:focus-visible,
.series-index a:focus-visible,
.related-project a:focus-visible {
outline: 2px solid var(--accent);
outline-offset: 3px;
border-radius: 2px;
}
.series-nav-spacer { min-width: 0; }
.series-index-label {
font-size: 0.7rem;
font-weight: 700;
letter-spacing: 0.1em;
text-transform: uppercase;
color: var(--text-muted);
margin: 0 0 0.6em;
}
.series-index {
list-style: none;
padding: 0;
margin: 0;
border-top: 1px solid rgba(128,128,128,0.12);
}
.series-index li {
display: grid;
grid-template-columns: 3.75em minmax(0, 1fr);
gap: 0.75em;
align-items: center;
min-height: 44px;
padding: 0.45em 0.6em;
border-bottom: 1px solid rgba(128,128,128,0.12);
}
.series-index li[aria-current='page'] {
border-left: 3px solid var(--accent);
background: var(--bg-secondary);
padding-left: calc(0.6em - 3px);
font-weight: 700;
}
.series-part {
font-size: 0.7rem;
font-weight: 700;
text-transform: uppercase;
color: var(--text-muted);
}
.series-index a {
display: flex;
align-items: center;
min-height: 44px;
color: var(--text);
text-decoration: none;
line-height: 1.35;
}
.series-index a:hover { color: var(--accent); }
.series-current-title {
display: flex;
align-items: baseline;
justify-content: space-between;
gap: 0.75em;
line-height: 1.35;
}
.series-current-marker {
flex: 0 0 auto;
font-size: 0.68rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.04em;
color: var(--text-muted);
}
.related-project {
margin-top: 1.5em;
padding-top: 1.25em;
border-top: 1px solid rgba(128,128,128,0.12);
}
.related-project p {
margin: 0;
font-size: 0.9rem;
color: var(--text-muted);
}
.related-project a {
font-weight: 700;
}

/* Post tags */
.post-tags {
display: flex;
flex-wrap: wrap;
gap: 0.4em;
margin: 2em 0 0;
padding-top: 1.5em;
border-top: 1px solid rgba(128,128,128,0.12);
}

/* Related reading */
.related {
margin-top: 2.5em;
padding-top: 1.5em;
border-top: 1px solid rgba(128,128,128,0.15);
}
.related-label {
font-size: 0.7rem;
font-weight: 700;
letter-spacing: 0.1em;
text-transform: uppercase;
color: var(--accent);
margin: 0 0 0.9em;
}
.related-list {
list-style: none;
padding: 0;
margin: 0;
display: flex;
flex-direction: column;
gap: 0.1em;
}
.related-link {
display: flex;
justify-content: space-between;
align-items: baseline;
gap: 1em;
padding: 0.6em 0;
border-bottom: 1px solid rgba(128,128,128,0.1);
text-decoration: none;
color: var(--text);
}
.related-link:last-child { border-bottom: none; }
.related-link:hover .related-title { color: var(--accent); }
.related-title { transition: color 0.15s; font-size: 0.95rem; }
.related-shared-tags {
display: flex;
gap: 0.3em;
flex-wrap: wrap;
flex-shrink: 0;
}
.related-tag {
font-size: 0.7rem;
color: var(--text-muted);
background: var(--bg-secondary);
padding: 0.1em 0.45em;
border-radius: 999px;
}
@media (max-width: 520px) {
.series-nav {
grid-template-columns: 1fr;
gap: 0.85em;
}
.series-nav-spacer { display: none; }
.series-nav-item.next {
align-items: flex-start;
text-align: left;
}
.series-index li {
grid-template-columns: 3.25em minmax(0, 1fr);
gap: 0.55em;
padding-left: 0.4em;
padding-right: 0.4em;
}
.series-index li[aria-current='page'] {
padding-left: calc(0.4em - 3px);
}
.series-current-title {
align-items: flex-start;
flex-direction: column;
gap: 0.15em;
}
}
</style>
</head>

<body>
<Header />
<main>
<article>
<div class="hero-image">
{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
</div>
<div class="prose">
<div class="title">
<div class="date">
{seriesGroup && seriesPart && (
<p class="series-label">{seriesGroup.definition.label} -- Part {seriesPart}</p>
)}
<FormattedDate date={pubDate} />
{updatedDate && (
<div class="last-updated-on">
Last updated on <FormattedDate date={updatedDate} />
</div>
)}
</div>
<h1>{title}</h1>
</div>
<slot />
{seriesGroup && (
<section
  class="series-context"
  aria-labelledby="in-this-series-heading"
  data-series-module={seriesGroup.key}
>
<div class="series-context-heading">
  <h2 id="in-this-series-heading">In this series: {seriesGroup.definition.label}</h2>
  <p>{seriesGroup.definition.description}</p>
</div>
<nav class="series-nav" aria-label={`${seriesGroup.definition.label} previous and next articles`}>
  {seriesPrev ? (
    <div class="series-nav-item prev" data-series-prev={seriesPrev.id}>
      <span class="series-nav-dir">&larr; Previous</span>
      <a href={`/blog/${seriesPrev.id}/`} class="series-nav-link">{seriesPrev.data.title}</a>
    </div>
  ) : <span class="series-nav-spacer" aria-hidden="true"></span>}
  {seriesNext ? (
    <div class="series-nav-item next" data-series-next={seriesNext.id}>
      <span class="series-nav-dir">Next &rarr;</span>
      <a href={`/blog/${seriesNext.id}/`} class="series-nav-link">{seriesNext.data.title}</a>
    </div>
  ) : <span class="series-nav-spacer" aria-hidden="true"></span>}
</nav>
<p class="series-index-label">Complete series</p>
<ol class="series-index">
  {seriesGroup.members.map((post) => (
    post.id === id ? (
      <li aria-current="page" data-series-current={post.id}>
        <span class="series-part">Part {post.data.seriesPart}</span>
        <span class="series-current-title">
          <span>{post.data.title}</span>
          <span class="series-current-marker">Current article</span>
        </span>
      </li>
    ) : (
      <li data-series-index-item={post.id}>
        <span class="series-part">Part {post.data.seriesPart}</span>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
      </li>
    )
  ))}
</ol>
</section>
)}
{relatedProject && (
<aside class="related-project" data-related-project={relatedProject.id}>
  <p>Related project: <a href={`/projects/${relatedProject.id}/`}>{relatedProject.data.title}</a></p>
</aside>
)}
{tags.length > 0 && (
<div class="post-tags">
{tags.map((tag) => (
<a href={`/tags/${tag}`} class="tag">{tag}</a>
))}
</div>
)}
{related.length > 0 && (
<div class="related">
<p class="related-label">Related reading</p>
<ul class="related-list">
{related.map((post) => (
<li>
<a href={`/blog/${post.id}`} class="related-link">
<span class="related-title">{post.data.title}</span>
<span class="related-meta">
<span style="font-size: 0.8rem; color: var(--text-muted);">
<FormattedDate date={post.data.pubDate} />
</span>
{post.data.tags.filter((t) => tags.includes(t)).length > 0 && (
<span class="related-shared-tags">
{post.data.tags
.filter((t) => tags.includes(t))
.map((t) => (
<span class="related-tag">{t}</span>
))}
</span>
)}
</span>
</a>
</li>
))}
</ul>
</div>
)}
</div>
</article>
</main>
<Footer />
</body>
</html>
