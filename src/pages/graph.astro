---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead
    title={`Graph — ${SITE_TITLE}`}
    description="Visual map of site content — posts, projects, and tags as a connected graph."
  />
  <style>
    /* Full-width layout overrides */
    main {
      max-width: 100% !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .graph-header {
      max-width: 740px;
      margin: 0 auto;
      padding: 2rem 1rem 1rem;
    }
    .graph-header h1 { margin-bottom: 0.25rem; }
    .graph-header p {
      color: var(--text-muted);
      margin: 0;
      font-size: 1rem;
    }
    .legend {
      max-width: 740px;
      margin: 0 auto;
      padding: 0.75rem 1rem 1.25rem;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .graph-container {
      position: relative;
      width: 100%;
      height: calc(100vh - 56px - 200px);
      min-height: 560px;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
      overflow: hidden;
    }
    #graph-svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* Loading spinner */
    .spinner-wrap {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      pointer-events: none;
    }
    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }
    .spinner-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .spinner { animation: none; }
    }
    /* Tooltip */
    #graph-tooltip {
      position: fixed;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.35rem 0.7rem;
      font-size: 0.8rem;
      color: var(--text);
      pointer-events: none;
      z-index: 999;
      box-shadow: var(--shadow);
      max-width: 240px;
      display: none;
      line-height: 1.4;
    }
    .graph-hint {
      max-width: 740px;
      margin: 0 auto;
      padding: 0.75rem 1rem;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    #graph-svg :global(.graph-label) {
      fill: var(--text-muted);
      font-size: 0.68rem;
      paint-order: stroke;
      stroke: var(--bg-secondary);
      stroke-width: 3px;
      stroke-linejoin: round;
    }
    #graph-svg :global(.graph-node:focus-visible) {
      outline: none;
      stroke: var(--text);
      stroke-width: 2.5px;
    }
    @media (max-width: 720px) {
      .graph-container { height: calc(100vh - 56px - 260px); min-height: 460px; }
      .legend { gap: 1rem; }
    }
  </style>
</head>
<body>
  <Header />
  <main>
    <div class="graph-header">
      <h1>Content graph</h1>
      <p>Every post, project, and tag -- and how they connect. Click any node to navigate.</p>
    </div>

    <div class="legend">
      <div class="legend-item">
        <span class="legend-dot" style="background: #2dd4bf;"></span>
        Post
      </div>
      <div class="legend-item">
        <span class="legend-dot" style="background: #f59e0b;"></span>
        Project
      </div>
      <div class="legend-item">
        <span class="legend-dot" style="background: #64748b;"></span>
        Tag
      </div>
      <div class="legend-item">
        <svg width="28" height="10" style="flex-shrink:0" aria-hidden="true">
          <line x1="0" y1="5" x2="28" y2="5" stroke="#2dd4bf" stroke-width="2.5" />
        </svg>
        projectRef link
      </div>
      <div class="legend-item">
        <svg width="28" height="10" style="flex-shrink:0" aria-hidden="true">
          <line x1="0" y1="5" x2="28" y2="5" stroke="#64748b" stroke-width="1" stroke-dasharray="4 2" />
        </svg>
        shared tag
      </div>
    </div>

    <div class="graph-container">
      <svg id="graph-svg" aria-label="Content relationship graph"></svg>
      <div class="spinner-wrap" id="spinner-wrap">
        <div class="spinner"></div>
        <span class="spinner-label">Mapping connections...</span>
      </div>
    </div>

    <div class="graph-hint">
      Scroll or pinch to zoom &middot; drag to pan &middot; drag nodes to reposition
    </div>
  </main>
  <Footer />

  <div id="graph-tooltip"></div>

  <script type="module">
    import * as d3 from 'https://cdn.jsdelivr.net/npm/d3@7/+esm';

    const resp = await fetch('/graph.json');
    const data = await resp.json();

    const container = document.getElementById('graph-svg').parentElement;
    const svgEl = document.getElementById('graph-svg');
    const tooltip = document.getElementById('graph-tooltip');
    const spinnerWrap = document.getElementById('spinner-wrap');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = container.clientWidth;
    let height = container.clientHeight;

    const svg = d3.select(svgEl)
      .attr('viewBox', `0 0 ${width} ${height}`);

    // Zoom + pan
    const g = svg.append('g');
    const zoomBehavior = d3.zoom()
      .scaleExtent([0.25, 4])
      .on('zoom', (event) => g.attr('transform', event.transform));
    svg.call(zoomBehavior);

    const nodeRadius = (d) => d.type === 'project' ? 12 : d.type === 'post' ? 8 : 5;
    const nodeColor = (d) => d.type === 'project' ? '#f59e0b' : d.type === 'post' ? '#2dd4bf' : '#64748b';
    const maxLabelLength = () => width < 520 ? 24 : width < 900 ? 34 : 42;
    const displayLabel = (d) => {
      const limit = maxLabelLength();
      return d.label.length > limit ? d.label.slice(0, limit - 1) + '\u2026' : d.label;
    };
    const labelOffset = (d) => nodeRadius(d) + 8;
    const labelCollisionRadius = (d) => {
      if (d.type === 'tag') return nodeRadius(d) + 12;
      return nodeRadius(d) + Math.min(70, displayLabel(d).length * 2.4) + 12;
    };

    // Edges
    const link = g.append('g')
      .selectAll('line')
      .data(data.edges)
      .join('line')
      .attr('stroke', (d) => d.type === 'projectRef' ? '#2dd4bf' : 'rgba(100,116,139,0.3)')
      .attr('stroke-width', (d) => d.type === 'projectRef' ? 2.5 : 1)
      .attr('stroke-dasharray', (d) => d.type === 'tag' ? '4 3' : null);

    // Nodes
    const node = g.append('g')
      .selectAll('circle')
      .data(data.nodes)
      .join('circle')
      .attr('r', nodeRadius)
      .attr('fill', nodeColor)
      .attr('stroke', (d) => d.type === 'post' || d.type === 'project' ? 'rgba(0,0,0,0.15)' : 'none')
      .attr('stroke-width', 1)
      .attr('cursor', 'pointer')
      .attr('class', 'graph-node')
      .attr('tabindex', (d) => d.url ? 0 : null)
      .attr('role', (d) => d.url ? 'link' : 'img')
      .attr('aria-label', (d) => `${d.label} (${d.type})`)
      .call(
        d3.drag()
          .on('start', (event, d) => {
            if (!event.active) simulation.alphaTarget(0.3).restart();
            d.fx = d.x; d.fy = d.y;
          })
          .on('drag', (event, d) => { d.fx = event.x; d.fy = event.y; })
          .on('end', (event, d) => {
            if (!event.active) simulation.alphaTarget(0);
            d.fx = null; d.fy = null;
          })
      );

    node.append('title')
      .text((d) => d.label);

    // Labels for post + project nodes only
    const label = g.append('g')
      .selectAll('text')
      .data(data.nodes.filter((d) => d.type !== 'tag'))
      .join('text')
      .attr('class', 'graph-label')
      .attr('pointer-events', 'none')
      .attr('dy', '0.35em')
      .text(displayLabel);

    const navigateToNode = (d) => {
      if (d.url) window.location.href = d.url;
    };

    // Tooltip
    node
      .on('mouseover', (event, d) => {
        tooltip.textContent = d.label;
        tooltip.style.display = 'block';
        tooltip.style.left = (event.clientX + 14) + 'px';
        tooltip.style.top = (event.clientY - 10) + 'px';
      })
      .on('mousemove', (event) => {
        tooltip.style.left = (event.clientX + 14) + 'px';
        tooltip.style.top = (event.clientY - 10) + 'px';
      })
      .on('mouseout', () => { tooltip.style.display = 'none'; })
      .on('click', (event, d) => {
        event.preventDefault();
        navigateToNode(d);
      })
      .on('keydown', (event, d) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          navigateToNode(d);
        }
      });

    const fitGraphToViewport = () => {
      const bounds = g.node().getBBox();
      if (!bounds.width || !bounds.height) return;
      const margin = width < 720 ? 28 : 44;
      const scale = Math.min(
        1,
        (width - margin * 2) / bounds.width,
        (height - margin * 2) / bounds.height
      );
      const x = width / 2 - scale * (bounds.x + bounds.width / 2);
      const y = height / 2 - scale * (bounds.y + bounds.height / 2);
      svg.transition()
        .duration(reduceMotion ? 0 : 260)
        .call(zoomBehavior.transform, d3.zoomIdentity.translate(x, y).scale(scale));
    };

    // Simulation
    const simulation = d3.forceSimulation(data.nodes)
      .force('link',
        d3.forceLink(data.edges)
          .id((d) => d.id)
          .distance((d) => d.type === 'projectRef' ? 130 : 82)
          .strength((d) => d.type === 'projectRef' ? 0.8 : 0.32)
      )
      .force('charge',
        d3.forceManyBody()
          .strength((d) => d.type === 'tag' ? -75 : d.type === 'project' ? -300 : -230)
      )
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('x', d3.forceX(width / 2).strength(0.035))
      .force('y', d3.forceY(height / 2).strength(0.035))
      .force('collide', d3.forceCollide().radius(labelCollisionRadius).iterations(2))
      .on('tick', () => {
        link
          .attr('x1', (d) => d.source.x)
          .attr('y1', (d) => d.source.y)
          .attr('x2', (d) => d.target.x)
          .attr('y2', (d) => d.target.y);
        node
          .attr('cx', (d) => d.x)
          .attr('cy', (d) => d.y);
        label
          .attr('x', (d) => d.x + (d.x < width / 2 ? labelOffset(d) : -labelOffset(d)))
          .attr('y', (d) => d.y)
          .attr('text-anchor', (d) => d.x < width / 2 ? 'start' : 'end');
      })
      .on('end', () => {
        spinnerWrap.style.display = 'none';
        fitGraphToViewport();
      });

    window.addEventListener('resize', () => {
      width = container.clientWidth;
      height = container.clientHeight;
      svg.attr('viewBox', `0 0 ${width} ${height}`);
      label.text(displayLabel);
      simulation
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('x', d3.forceX(width / 2).strength(0.035))
        .force('y', d3.forceY(height / 2).strength(0.035))
        .force('collide', d3.forceCollide().radius(labelCollisionRadius).iterations(2))
        .alpha(0.35)
        .restart();
    });
  </script>
</body>
</html>
