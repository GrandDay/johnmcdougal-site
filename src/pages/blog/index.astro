---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getSeriesGroups } from '../../lib/series';

const pageDescription =
	'Essays and technical notes on systems, documentation, AI workflows, Cloudflare, email infrastructure, and building johnmcdougal.com.';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const seriesGroups = await getSeriesGroups();

const tagMap = new Map<string, number>();
posts.forEach((post) => {
	post.data.tags.forEach((tag) => {
		tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
	});
});
const allTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing — ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			<p class="lead">Essays, walkthroughs, and thinking out loud. Process over polish.</p>

			{allTags.length > 0 && (
				<div class="tag-bar">
					{allTags.map(([tag]) => (
						<a href={`/tags/${tag}`} class="tag">{tag}</a>
					))}
				</div>
			)}

			{posts.length === 0 && (
				<p style="color: var(--text-muted)">Nothing published yet — something is always in the draft pile. Check back soon.</p>
			)}

			<section class="series-strip" aria-labelledby="series-heading" data-series-strip>
				<div class="series-strip-heading">
					<h2 id="series-heading">Series</h2>
					<a href="/series">All series &rarr;</a>
				</div>
				<ul>
					{seriesGroups.map(({ key, entry, members }) => (
						<li data-series-group={key}>
							<a href={`/series/${key}/`}>{entry.data.title}</a>
							<span>{members.length} {members.length === 1 ? 'post' : 'posts'}</span>
						</li>
					))}
				</ul>
			</section>

			<section aria-labelledby="all-writing-heading" data-chronological-index>
				<div class="section-heading all-writing-heading">
					<h2 id="all-writing-heading">All writing</h2>
					<p>Every post in reverse chronological order.</p>
				</div>
				<ul class="post-list">
					{posts.map((post) => (
						<li data-chronological-post={post.id}>
							<a href={`/blog/${post.id}/`} class="post-card">
								<div class="post-header">
									<h3>{post.data.title}</h3>
									{post.data.series && post.data.seriesPart && (
										<span class="series-badge">Part {post.data.seriesPart}</span>
									)}
								</div>
								{post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
								<div class="post-meta">
									<span class="date"><FormattedDate date={post.data.pubDate} /></span>
									{post.data.tags.length > 0 && (
										<div class="post-tags">
											{post.data.tags.map((tag) => (
												<span class="tag-label">{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 { margin-bottom: 0.25em; }
	.lead {
		color: var(--text-muted);
		margin-bottom: 1.5em;
		font-size: 1.05em;
	}
	.tag-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 2em;
		padding-bottom: 1.5em;
		border-bottom: 1px solid var(--border);
	}
	.section-heading {
		margin-bottom: 1em;
	}
	.section-heading h2 {
		font-size: 1.35em;
		margin-bottom: 0.2em;
	}
	.section-heading p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95em;
	}
	.series-strip {
		margin-bottom: 2.5em;
		padding-bottom: 1.25em;
		border-bottom: 1px solid var(--border);
	}
	.series-strip-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 0.5em;
	}
	.series-strip-heading h2 {
		font-size: 1.35em;
		margin: 0;
	}
	.series-strip-heading a {
		font-size: 0.85em;
	}
	.series-strip ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.series-strip li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		min-height: 44px;
		border-bottom: 1px solid rgba(128,128,128,0.1);
	}
	.series-strip li:last-child {
		border-bottom: 0;
	}
	.series-strip li a {
		display: flex;
		align-items: center;
		min-height: 44px;
		color: var(--text);
		font-weight: 600;
	}
	.series-strip li a:hover,
	.series-strip li a:focus-visible {
		color: var(--accent);
		text-decoration: underline;
	}
	.series-strip li span {
		flex: 0 0 auto;
		font-size: 0.8em;
		color: var(--text-muted);
	}
	.all-writing-heading {
		margin-bottom: 1em;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
	}
	.post-card {
		display: block;
		padding: 1.25em 1.5em;
		background: var(--bg-secondary);
		text-decoration: none;
		color: var(--text);
		transition: background 0.15s ease;
	}
	.post-card:hover {
		background: var(--bg);
	}
	.post-card:hover h3 {
		color: var(--accent);
	}
	.post-header {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin-bottom: 0.25em;
	}
	.post-header h3 {
		font-size: 1.1em;
		margin: 0;
		transition: color 0.15s ease;
	}
	.post-desc {
		margin: 0 0 0.6em;
		color: var(--text-muted);
		font-size: 0.95em;
	}
	.post-meta {
		display: flex;
		align-items: center;
		gap: 1em;
		flex-wrap: wrap;
	}
	.date {
		font-size: 0.8em;
		color: var(--text-muted);
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.tag-label {
		font-size: 0.7em;
		color: var(--text-muted);
		background: var(--bg);
		padding: 0.15em 0.5em;
		border-radius: 999px;
		border: 1px solid var(--border);
	}
	@media (max-width: 420px) {
		.post-card {
			padding: 1em;
		}
		.post-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.4em;
		}
	}
</style>
