---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const projectPriority = [
	'homelab',
	'cue-verse',
	'phred',
	'aeon-desktop',
	'userspace',
	'johnmcdougal-site',
];

const projectEvidence: Record<string, string> = {
	'homelab': 'Operational lab with private implementation and recovery workflows',
	'cue-verse': 'Evolving documentation and source-of-truth framework',
	'phred': 'Operational local AI infrastructure lab',
	'aeon-desktop': 'Validated Linux workstation practice',
	'userspace': 'Evolving tools, data, and knowledge workflow',
	'johnmcdougal-site': 'Active public documentation platform',
};

const priorityRank = new Map(projectPriority.map((id, index) => [id, index]));
const projects = (await getCollection('projects')).sort((a, b) => {
	const aRank = priorityRank.get(a.id);
	const bRank = priorityRank.get(b.id);
	if (aRank !== undefined || bRank !== undefined) {
		return (aRank ?? Number.MAX_SAFE_INTEGER) - (bRank ?? Number.MAX_SAFE_INTEGER);
	}

	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const tagMap = new Map<string, number>();
projects.forEach((project) => {
	project.data.tags.forEach((tag) => {
		tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
	});
});
const allTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const statusLabel = { active: 'Active', wip: 'WIP', archived: 'Archived' };
const statusColor = { active: 'var(--accent)', wip: '#f59e0b', archived: 'var(--text-muted)' };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<p class="lead">
				Things I'm building, experimenting with, or have documented along the way.
				Process over polish — the WIPs are as much the point as the finished ones.
			</p>

			{allTags.length > 0 && (
				<div class="tag-bar">
					{allTags.map(([tag]) => (
						<a href={`/tags/${tag}`} class="tag">{tag}</a>
					))}
				</div>
			)}

			{projects.length === 0 && (
				<p style="color: var(--text-muted)">Projects coming soon. Watch this space.</p>
			)}

			<ul class="project-list">
				{projects.map((project) => (
					<li>
						<article class="project-card">
							<div class="project-header">
								<h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
								<span
									class="status-badge"
									style={`color: ${statusColor[project.data.status]}; border-color: ${statusColor[project.data.status]};`}
								>
									{statusLabel[project.data.status]}
								</span>
							</div>
							{projectEvidence[project.id] && <p class="evidence">{projectEvidence[project.id]}</p>}
							<p>{project.data.description}</p>
							<div class="project-meta">
								<span class="date"><FormattedDate date={project.data.pubDate} /></span>
								<div class="tags">
									{project.data.tags.map((tag) => (
										<a href={`/tags/${tag}`} class="tag">{tag}</a>
									))}
								</div>
							</div>
						</article>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 { margin-bottom: 0.25em; }
	.lead {
		color: var(--text-muted);
		margin-bottom: 1.5em;
		font-size: 1.05em;
	}
	.tag-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-bottom: 2em;
		padding-bottom: 1.5em;
		border-bottom: 1px solid var(--border);
	}
	.project-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
	}
	.project-card {
		display: block;
		padding: 1.25em 1.5em;
		background: var(--bg-secondary);
		color: var(--text);
		transition: background 0.15s ease;
	}
	.project-card:hover {
		background: var(--bg);
	}
	.project-card:hover h2 a {
		color: var(--accent);
	}
	.project-header {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin-bottom: 0.25em;
	}
	h2 {
		font-size: 1.1em;
		margin: 0;
		flex: 1 1 auto;
		min-width: 0;
	}
	h2 a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	h2 a:hover,
	h2 a:focus {
		color: var(--accent);
		text-decoration: underline;
	}
	.status-badge {
		flex: 0 0 auto;
		font-size: 0.7em;
		font-weight: 700;
		padding: 0.15em 0.5em;
		border: 1px solid;
		border-radius: 999px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	p {
		margin: 0 0 0.75em;
		color: var(--text-muted);
		font-size: 0.95em;
	}
	.evidence {
		margin-bottom: 0.35em;
		color: var(--accent);
		font-size: 0.82em;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.project-meta {
		display: flex;
		align-items: center;
		gap: 1em;
		flex-wrap: wrap;
	}
	.date {
		font-size: 0.8em;
		color: var(--text-muted);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	@media (max-width: 520px) {
		.project-card {
			padding: 1em;
		}
		.project-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.45em;
		}
	}
</style>