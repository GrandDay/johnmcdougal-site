{
  "name": "johnmcdougal-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "verify-build:sync-baseline": "node scripts/sync-verify-build-baseline.mjs",
    "whitespace:fix-staged": "node scripts/fix-staged-whitespace.mjs",
    "commit:check": "node scripts/verify-commit.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs install",
    "hooks:status": "node scripts/install-git-hooks.mjs status",
    "test:commit-workflow": "node --test scripts/test-commit-workflow.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "validate": "node scripts/validate.mjs",
    "review": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/review.ps1 refresh",
    "review:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/review.ps1 status",
    "review:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/review.ps1 stop"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "posthog-js": "^1.369.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@12.0.2"
}
